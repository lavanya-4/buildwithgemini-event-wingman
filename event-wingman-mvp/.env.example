# Event Wingman Configuration
# Google Cloud Vertex AI settings (Application Default Credentials used by default)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash

# Optional: Google AI Studio API key (if Vertex AI is not used)
# GEMINI_API_KEY=your-gemini-api-key

# Text to Speech Voice
TTS_VOICE_NAME=en-US-Journey-F

# Server
PORT=8000
HOST=0.0.0.0
DB_PATH=event_wingman.db
